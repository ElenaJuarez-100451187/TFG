#include <WiFi.h>
#include <WiFiUdp.h>

// PINES DE DIRECCIÓN
const int AIN1 = 26; // controla sentido rueda A
const int AIN2 = 27; // controla sentido rueda A
const int BIN1 = 13; // controla sentido rueda B
const int BIN2 = 14; // controla sentido rueda B
const int LED_BUILTIN_ESP32 = 2; // en la mayoría de ESP32 Dev Module el LED azul es el pin 2

// PINES DE VELOCIDAD (PWM)
const int pin_velocidad = 25; 
const int pwm_freq = 5000; // en Hz
const int pwm_resolution = 8; // 8 bits --> valores de 0 a 255

// PIN DE SEÑAL DE ENTRADA
const int pin_encoder = 34; 

// VELOCIDADES (0-255)
const int v_normal = 200;
const int v_reducida = 60;

// DATOS DE LA RUEDA
const float diametro_rueda = 6.5; //cm
const int pulsos_xvuelta = 20;
const float distancia_xvuelta = (PI * diametro_rueda) / (pulsos_xvuelta); //cm

// CONTEO DE PULSOS E INTERRUPCIONES
volatile int pulsos = 0;
long tiempoAnterior = 0;
const long intervalo = 200; //ms

// CONFIGURACIÓN WIFI
const char* ssid = "MOVISTAR_801F";
const char* password = "F062D689D0147B9D2641";
const int puerto_udp = 4210;
// Creación de IP fija para el coche
IPAddress ip_local(192, 168, 1, 51); // IP asignado a esta ESP32
IPAddress gateway(192, 168, 1, 1); // IP del wifi
IPAddress subnet(255, 255, 255, 0);
// IP del destinatario
IPAddress ip_pc(192, 168, 1, 52);

WiFiUDP udp;
int limite_pulsos = 1;

// INTERRUPCIONES
void IRAM_ATTR contarPulso()
{
  pulsos++;
}


void setup() {
  pinMode(AIN1, OUTPUT);
  pinMode(AIN2, OUTPUT);
  pinMode(BIN1, OUTPUT);
  pinMode(BIN2, OUTPUT);

  digitalWrite(AIN1, HIGH);
  digitalWrite(AIN2, LOW);
  digitalWrite(BIN1, HIGH);
  digitalWrite(BIN2, LOW);

  pinMode(pin_velocidad, OUTPUT);
  pinMode(LED_BUILTIN_ESP32, OUTPUT);
  pinMode(pin_encoder, INPUT);
  attachInterrupt(digitalPinToInterrupt(pin_encoder), contarPulso, FALLING);
  ledcAttach(pin_velocidad, pwm_freq, pwm_resolution);

  Serial.begin(115200);

  WiFi.mode(WIFI_STA);
  conexion_wifi();
  udp.begin(puerto_udp);
}


void loop() {
  // Revisamos si ha llegado algún mensaje del radar en cada vuelta
  revisarUDP();

  long ahora = millis();
  if (ahora - tiempoAnterior < intervalo)
  {
    return; // como no hemos llegado a los 100ms, aun no medimos
  }
  
  long dt = ahora - tiempoAnterior;
  tiempoAnterior = ahora;
  
  // Calculamos la velocidad instantánea (pulsos/segundo en estos ultimos dt ms)
  float v_actual = medir_velocidad(dt);
  float v_cms = v_actual * distancia_xvuelta;
  enviarUDP(ip_pc, "Velocidad instantánea: " + String(v_cms, 2) + " cm/s");
  
  // Control de velocidad según el limite recibido
  controlar_velocidad(v_actual, limite_pulsos);

}


float medir_velocidad(long dt)
{
  noInterrupts();
  int pulsosCopia = pulsos;
  pulsos = 0;
  interrupts();
  return pulsosCopia * (1000.0 / dt);
}


void controlar_velocidad(float v_actual, int limite)
{
  float v_cms = v_actual * distancia_xvuelta;

  if (limite == 1)
  {
    // Todavía no hallegado ninguna señal: velocidad preestablecida
    ledcWrite(pin_velocidad, v_normal);
    digitalWrite(LED_BUILTIN_ESP32, LOW);
    Serial.println("Sin señal: velocidad normal = ");
    Serial.print(v_cms, 2);
    Serial.println(" cm/s");
  }
  else
  {
    if (v_actual > limite)
    {

      ledcWrite(pin_velocidad, v_reducida);
      digitalWrite(LED_BUILTIN_ESP32, HIGH); // LED encendido = modo reducido
      Serial.print("Modo REDUCIDO. Limite = "); Serial.print(limite_pulsos);
      Serial.print(limite * distancia_xvuelta, 2);
      Serial.println(" cm/s superado. v_actual = ");
      Serial.print(v_cms, 2);
      Serial.println(" cm/s");
    }
    else 
    {
      Serial.print(v_cms, 2);
      Serial.println(" cm/s");
    }
  }
}


void conexion_wifi()
{
  WiFi.config(ip_local, gateway, subnet);
  WiFi.begin(ssid, password);

  Serial.print("Conectando a: ");
  Serial.print(ssid);

  // Esperar a conectarse
  while (WiFi.status() != WL_CONNECTED)
  {
    delay(200);
    Serial.print("...");
  }

  Serial.print("Conectado. IP del coche: ");
  Serial.println(WiFi.localIP());
}


void enviarUDP(IPAddress destino, String mensaje)
// Envio de string para poder enviar tipos de datos distintos
{
  udp.beginPacket(destino, puerto_udp);
  udp.print(mensaje);
  udp.endPacket();
}


void revisarUDP()
{
  int tamano_paquete = udp.parsePacket();
  
  if (tamano_paquete > 0)
  {
    char buffer[64];
    int len = udp.read(buffer, sizeof(buffer) - 1);
    buffer[len] = '\0';
    String mensaje = String(buffer);

    Serial.print("Paquete UDP recibido: [");
    Serial.print(mensaje);
    Serial.println("]");

    if (mensaje.startsWith("SENAL:"))
    {
      float limite_cms = mensaje.substring(6).toFloat(); 
      limite_pulsos = round(limite_cms / distancia_xvuelta); //conversion a pulsos

      enviarUDP(ip_pc, "Limite recibido del radar: " + String(limite_cms, 2) + " cm/s");
      Serial.print("LIMITE RECIBIDO DEL RADAR: ");
      Serial.print(limite_cms);
      Serial.print(" cm/s");
    }
  }
}
